{
  "manifest_version": 3,
  "name": "TATANGA - En ucuzu bul",
  "version": "1.0.0",
  "description": "Web'de gordugun urunu TATANGA'ya gonderir: tum platformlarda (Vinted, Kleinanzeigen, eBay, Sellpy) en ucuz ayni/benzer ilan ve gercek satis fiyati.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://localhost:8501/*", "http://127.0.0.1:8501/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "TATANGA: en ucuzu bul",
              "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "options_page": "options.html"
}
