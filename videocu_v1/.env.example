# VIDEOCU v1 - Environment Variables
# Copy this file to .env and fill in your credentials

# ========== DATABASE (Production) ==========
POSTGRES_DB=videocu_db
POSTGRES_USER=videocu_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
# POSTGRES_URL=postgresql://videocu_user:password@postgres:5432/videocu_db

# ========== REDIS/CELERY (Production) ==========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ========== JWT AUTHENTICATION ==========
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_abc123def456

# ===== AI SERVICES =====
# Gemini API (Required for Chef AI intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (Optional - for premium TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ===== IMAGE PROVIDERS =====
# Pexels API (Recommended - HD stock photos)
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash API (Optional - additional HD stock photos)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# ===== SOCIAL MEDIA =====
# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# TikTok API (Optional)
TIKTOK_API_KEY=your_tiktok_api_key_here

# Instagram API (Optional)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ===== TELEGRAM BOT =====
# Telegram Bot Token (Required for bot interface)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Authorized Users (comma-separated Telegram user IDs)
# Leave empty to allow all users
TELEGRAM_AUTHORIZED_USERS=123456789,987654321

# ===== TREND ANALYSIS =====
# Google Custom Search (Optional - for trend research)
GOOGLE_CSE_ID=your_custom_search_engine_id
GOOGLE_CSE_API_KEY=your_google_cse_api_key

# ===== SYSTEM =====
# Environment: development, production
ENVIRONMENT=production

# API Port (external)
API_PORT=8000

# Output directory
OUTPUT_DIR=output

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Max video duration (seconds)
MAX_VIDEO_DURATION=900

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# ===== DEPLOYMENT NOTES =====
# - Copy this file to .env before deploying
# - Fill in all REQUIRED fields (marked with CHANGE_THIS)
# - Never commit .env file to git
# - Use strong passwords for production
# - Rotate API keys periodically
